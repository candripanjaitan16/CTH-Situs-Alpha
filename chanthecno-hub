#!/usr/bin/env python3
"""Local production launcher and per-user maintenance commands."""
import argparse
import fcntl
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
import webbrowser

ROOT = Path(__file__).resolve().parent
PYTHON = ROOT / 'backend/.venv/bin/python'
sys.path.insert(0, str(ROOT / 'backend'))
from app.paths import STATE_HOME, prepare


def stop_process(process):
    if process is None or process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
        process.wait(timeout=10)
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGKILL)
        process.wait()
    except ProcessLookupError:
        pass


def main():
    parser = argparse.ArgumentParser(description='ChanThecno Training Hub')
    parser.add_argument('--no-browser', action='store_true')
    parser.add_argument('command', nargs='?', choices=['reset-local', 'restore-local', 'connect-drive', 'connect-colab', 'uninstall'])
    parser.add_argument('--backup', type=Path, help='Backup directory for restore-local')
    parser.add_argument('--confirm', action='store_true', help='Confirm local reset or restore')
    args = parser.parse_args()
    if args.command == 'uninstall':
        return subprocess.call([sys.executable, str(ROOT / 'tools/install.py'), '--uninstall'])
    if not PYTHON.is_file():
        raise RuntimeError('Jalankan python3 tools/install.py terlebih dahulu.')
    if args.command in {'reset-local', 'restore-local'}:
        command = [str(PYTHON), '-m', 'app.maintenance', args.command]
        if args.confirm:
            command.append('--confirm')
        if args.backup:
            command.extend(['--backup', str(args.backup)])
        return subprocess.call(command, cwd=ROOT / 'backend')
    if args.command in {'connect-drive', 'connect-colab'}:
        return subprocess.call([str(PYTHON), '-m', 'app.drive_auth', '--' + args.command], cwd=ROOT / 'backend')
    if not (ROOT / 'frontend/dist/index.html').is_file():
        raise RuntimeError('Build frontend produksi belum tersedia. Jalankan installer.')
    prepare()
    with (STATE_HOME / 'application.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('CTH atau pemeliharaan lokal masih berjalan.') from None
        for host in ('127.0.0.1', '::1'):
            try:
                with socket.create_connection((host, 8000), timeout=.5):
                    raise RuntimeError('Port 8000 dipakai proses lain. Tidak menghentikan proses tersebut.')
            except OSError:
                pass
        process = None
        previous = {}
        def interrupted(signum, frame):
            raise KeyboardInterrupt
        try:
            for sig in (signal.SIGINT, signal.SIGTERM):
                previous[sig] = signal.signal(sig, interrupted)
            process = subprocess.Popen(
                [str(PYTHON), '-m', 'uvicorn', 'app.main:app', '--host', '127.0.0.1', '--port', '8000'],
                cwd=ROOT / 'backend', start_new_session=True,
            )
            opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
            deadline = time.monotonic() + 60
            while True:
                if process.poll() is not None:
                    raise RuntimeError('Backend berhenti; periksa pesan terminal.')
                try:
                    with opener.open('http://127.0.0.1:8000/api/hello', timeout=2) as response:
                        if response.status == 200:
                            break
                except (urllib.error.URLError, OSError):
                    pass
                if time.monotonic() > deadline:
                    raise RuntimeError('Backend belum siap setelah 60 detik.')
                time.sleep(.2)
            url = 'http://127.0.0.1:8000'
            print(f'CTH siap: {url}\nTekan Ctrl+C untuk keluar.', flush=True)
            if not args.no_browser:
                try:
                    if not webbrowser.open(url):
                        print('Browser tidak terbuka otomatis. Buka alamat di atas.')
                except webbrowser.Error:
                    print('Browser tidak terbuka otomatis. Buka alamat di atas.')
            return process.wait()
        finally:
            stop_process(process)
            for sig, handler in previous.items():
                signal.signal(sig, handler)


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print('\nCTH dihentikan. Data pengguna dipertahankan.')
    except (RuntimeError, OSError, ValueError) as error:
        print(f'CTH: {error}', file=sys.stderr)
        raise SystemExit(1)
