#!/usr/bin/env python3

import os
import shutil
import signal
import socket
import subprocess
import time
import urllib.error
import urllib.request
import webbrowser
from pathlib import Path


ROOT = Path(__file__).resolve().parent

BACKEND = ROOT / "backend"
FRONTEND = ROOT / "frontend"
PYTHON = BACKEND / ".venv" / "bin" / "python"

BACKEND_URL = "http://127.0.0.1:8000/api/hello"
FRONTEND_URL = "http://localhost:5173"

processes = []


def port_in_use(port):
    for host in ("127.0.0.1", "::1"):
        try:
            with socket.create_connection((host, port), timeout=0.5):
                return True
        except OSError:
            continue

    return False


def start_process(command, directory):
    environment = os.environ.copy()
    environment["PYTHONUNBUFFERED"] = "1"

    process = subprocess.Popen(
        command,
        cwd=directory,
        env=environment,
        start_new_session=True,
    )

    processes.append(process)
    return process


def wait_until_ready(url, process, label):
    deadline = time.monotonic() + 90

    # Pemeriksaan lokal tidak melalui proxy
    opener = urllib.request.build_opener(
        urllib.request.ProxyHandler({})
    )

    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise RuntimeError(
                f"{label} berhenti. Periksa pesan terminal di atas."
            )

        try:
            with opener.open(url, timeout=2) as response:
                if response.status == 200:
                    return
        except (urllib.error.URLError, OSError):
            pass

        time.sleep(0.5)

    raise RuntimeError(
        f"{label} belum siap setelah 90 detik."
    )


def stop_processes():
    # Hanya hentikan proses yang dibuat peluncur ini
    for process in reversed(processes):
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass

    for process in reversed(processes):
        try:
            process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass

            process.wait()


def main():
    if not PYTHON.is_file():
        raise RuntimeError(
            "Python backend tidak ditemukan di backend/.venv/bin/python."
        )

    if not (FRONTEND / "package.json").is_file():
        raise RuntimeError(
            "frontend/package.json tidak ditemukan."
        )

    npm = shutil.which("npm")

    if not npm:
        raise RuntimeError("Perintah npm tidak ditemukan.")

    for port in (8000, 5173):
        if port_in_use(port):
            raise RuntimeError(
                f"Port {port} masih digunakan. "
                "Hentikan server lama dengan Ctrl+C di terminalnya, "
                "lalu jalankan kembali peluncur."
            )

    print("\nChanThecno Training Hub", flush=True)
    print("Menyalakan backend...", flush=True)

    backend = start_process(
        [
            str(PYTHON),
            "-m",
            "uvicorn",
            "app.main:app",
            "--host",
            "127.0.0.1",
            "--port",
            "8000",
        ],
        BACKEND,
    )

    wait_until_ready(BACKEND_URL, backend, "Backend")

    print("Menyalakan frontend...", flush=True)

    frontend = start_process(
        [
            npm,
            "run",
            "dev",
            "--",
            "--host",
            "localhost",
            "--port",
            "5173",
            "--strictPort",
        ],
        FRONTEND,
    )

    wait_until_ready(FRONTEND_URL, frontend, "Frontend")

    print(f"\nCTH siap: {FRONTEND_URL}", flush=True)
    print("Tekan Ctrl+C untuk menghentikan kedua server.", flush=True)

    try:
        webbrowser.open(FRONTEND_URL)
    except webbrowser.Error:
        print("Buka alamat CTH secara manual di browser.", flush=True)

    while True:
        for process, label in (
            (backend, "Backend"),
            (frontend, "Frontend"),
        ):
            if process.poll() is not None:
                raise RuntimeError(
                    f"{label} berhenti. Periksa pesan terminal."
                )

        time.sleep(1)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nMenghentikan CTH...", flush=True)
    except Exception as error:
        print(f"\nCTH gagal dijalankan: {error}", flush=True)
        raise SystemExit(1)
    finally:
        stop_processes()